# LLM & Embedding API Keys
GOOGLE_API_KEY=your_google_api_key_here
OPENAI_API_KEY=
GROQ_API_KEY=
COHERE_API_KEY=

# Vector Database & Persistence
CHROMA_PERSIST_DIRECTORY=./data/chroma_db
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development


# Download models on first use; set true only after provisioning an offline cache.
RAG_MODEL_LOCAL_ONLY=false
# HF_HOME=/absolute/path/to/persistent/model-cache
